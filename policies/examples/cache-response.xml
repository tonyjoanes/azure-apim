<policies>
    <inbound>
        <base />
        <!--
        Cache lookup - Check if response is in cache
        vary-by-developer: Cache per developer account
        vary-by-developer-groups: Cache per developer group
        -->
        <cache-lookup vary-by-developer="false"
                     vary-by-developer-groups="false"
                     downstream-caching-type="none"
                     must-revalidate="true"
                     caching-type="internal">
            <!-- Vary cache by query parameters -->
            <vary-by-query-parameter>category</vary-by-query-parameter>
            <vary-by-query-parameter>page</vary-by-query-parameter>

            <!-- Vary cache by request headers -->
            <vary-by-header>Accept</vary-by-header>
            <vary-by-header>Accept-Language</vary-by-header>
        </cache-lookup>

        <!-- Alternative: Cache by subscription key -->
        <!--
        <cache-lookup-value key="@("products-" + context.Subscription.Key)"
                           variable-name="cachedProducts" />
        <choose>
            <when condition="@(context.Variables.ContainsKey("cachedProducts"))">
                <return-response>
                    <set-status code="200" />
                    <set-header name="X-Cache" exists-action="override">
                        <value>HIT</value>
                    </set-header>
                    <set-body>@((string)context.Variables["cachedProducts"])</set-body>
                </return-response>
            </when>
        </choose>
        -->
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
        <!--
        Cache store - Save response to cache
        duration: Cache duration in seconds
        -->
        <cache-store duration="3600" />

        <!-- Add cache status header -->
        <set-header name="X-Cache" exists-action="override">
            <value>@(context.Variables.ContainsKey("IsCacheHit") &amp;&amp; (bool)context.Variables["IsCacheHit"] ? "HIT" : "MISS")</value>
        </set-header>

        <!-- Add cache expiry header -->
        <set-header name="Cache-Control" exists-action="override">
            <value>public, max-age=3600</value>
        </set-header>

        <!-- Alternative: Store in cache with custom key -->
        <!--
        <cache-store-value key="@("products-" + context.Subscription.Key)"
                          value="@(context.Response.Body.As<string>())"
                          duration="3600" />
        -->
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
