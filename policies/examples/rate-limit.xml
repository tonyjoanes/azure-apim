<policies>
    <inbound>
        <base />
        <!-- Rate limit: 10 calls per minute per subscription -->
        <rate-limit calls="10" renewal-period="60" />

        <!-- Quota: 1000 calls per day per subscription -->
        <quota calls="1000" renewal-period="86400" />

        <!-- Alternative: Rate limit by IP address -->
        <!--
        <rate-limit-by-key calls="100"
                          renewal-period="60"
                          counter-key="@(context.Request.IpAddress)" />
        -->

        <!-- Alternative: Rate limit by user ID from JWT -->
        <!--
        <rate-limit-by-key calls="50"
                          renewal-period="60"
                          counter-key="@(context.Request.Headers.GetValueOrDefault("Authorization","").AsJwt()?.Claims["sub"].FirstOrDefault())" />
        -->
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
        <!-- Add rate limit headers to response -->
        <set-header name="X-Rate-Limit-Limit" exists-action="override">
            <value>10</value>
        </set-header>
        <set-header name="X-Rate-Limit-Remaining" exists-action="override">
            <value>@{
                var remainingCalls = 10;
                return remainingCalls.ToString();
            }</value>
        </set-header>
    </outbound>
    <on-error>
        <base />
        <!-- Custom error message for rate limit exceeded -->
        <choose>
            <when condition="@(context.LastError.Reason == "RateLimitExceeded")">
                <return-response>
                    <set-status code="429" reason="Too Many Requests" />
                    <set-header name="Retry-After" exists-action="override">
                        <value>60</value>
                    </set-header>
                    <set-body>@{
                        return new JObject(
                            new JProperty("error", "Rate limit exceeded"),
                            new JProperty("message", "You have exceeded the rate limit. Please try again in 60 seconds."),
                            new JProperty("retryAfter", 60)
                        ).ToString();
                    }</set-body>
                </return-response>
            </when>
        </choose>
    </on-error>
</policies>
