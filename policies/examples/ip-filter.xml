                            new JProperty("message", "Access denied from IP: " + context.Request.IpAddress),
                            new JProperty("timestamp", DateTime.UtcNow.ToString("o"))
                        ).ToString();
                    }</set-body>
                </return-response>
            </when>
        </choose>
        -->

        <!-- Alternative: Check if IP is in named value (comma-separated list) -->
        <!--
        <choose>
            <when condition="@{
                var clientIp = context.Request.IpAddress;
                var allowedIps = "{{allowed-ip-addresses}}".Split(',').Select(ip => ip.Trim());
                return !allowedIps.Contains(clientIp);
            }">
                <return-response>
                    <set-status code="403" reason="Forbidden" />
