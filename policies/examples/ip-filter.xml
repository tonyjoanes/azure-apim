                    </set-header>
                    <set-body>{"error": "IP address not allowed"}</set-body>
                </return-response>
            </when>
        </choose>
        -->

        <!-- Log allowed IP -->
        <trace source="ip-filter" severity="information">
            <message>@("Request allowed from IP: " + context.Request.IpAddress)</message>
        </trace>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
        <!-- Custom error for IP filtering -->
        <choose>
            <when condition="@(context.LastError.Reason == "Forbidden")">
                <return-response>
                    <set-status code="403" reason="Forbidden" />
                    <set-body>@{
                        return new JObject(
                            new JProperty("error", "Forbidden"),
                            new JProperty("message", "Your IP address is not allowed to access this API"),
                            new JProperty("ip", context.Request.IpAddress),
                            new JProperty("timestamp", DateTime.UtcNow.ToString("o"))
                        ).ToString();
                    }</set-body>
                </return-response>
            </when>
        </choose>
    </on-error>
</policies>
