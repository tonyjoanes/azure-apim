<policies>
    <inbound>
        <base />
        <!-- IP Filter - Allow specific IP addresses or ranges -->
        <ip-filter action="allow">
            <!-- Single IP addresses -->
            <address>13.66.201.169</address>
            <address>13.66.140.128</address>

            <!-- IP address range using CIDR notation -->
            <address-range from="13.66.0.0" to="13.66.255.255" />

            <!-- Another range -->
            <address-range from="192.168.1.0" to="192.168.1.255" />
        </ip-filter>

        <!-- Alternative: Deny specific IPs (blacklist) -->
        <!--
        <ip-filter action="forbid">
            <address>203.0.113.42</address>
            <address-range from="198.51.100.0" to="198.51.100.255" />
        </ip-filter>
        -->

        <!-- Alternative: Custom IP validation logic -->
        <!--
        <choose>
            <when condition="@{
                var clientIp = context.Request.IpAddress;
