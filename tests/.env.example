# Azure APIM Configuration
# Copy this file to .env and fill in your values
# Never commit .env file to source control

# APIM Gateway URL (without https://)
APIM_GATEWAY=your-apim-name.azure-api.net

# Subscription Keys
SUBSCRIPTION_KEY=your-subscription-key-here
STARTER_KEY=your-starter-product-key
PREMIUM_KEY=your-premium-product-key

# JWT Tokens (if using OAuth/JWT authentication)
JWT_TOKEN=your-jwt-token-here

# Backend API URL (for direct backend testing)
BACKEND_API_URL=https://your-backend-api.azurewebsites.net
